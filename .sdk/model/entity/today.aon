# Entity: today

main: kit: entity: today: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      short: "Unique identifier for the fact"
      type: "`$STRING`"
    }
    {
      name: "language"
      req: false
      short: "Language code of the fact"
      type: "`$STRING`"
    }
    {
      name: "permalink"
      req: false
      short: "Permanent link to the fact"
      type: "`$STRING`"
    }
    {
      name: "source"
      req: false
      short: "Source of the fact"
      type: "`$STRING`"
    }
    {
      name: "source_url"
      req: false
      short: "URL to the fact source"
      type: "`$STRING`"
    }
    {
      name: "text"
      req: false
      short: "The useless fact text"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "today"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            header: [
              {
                example: "application/json"
                kind: "header"
                name: "accept"
                orig: "accept"
                reqd: false
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: "en"
                kind: "query"
                name: "language"
                orig: "language"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/v2/facts/today"
          parts: [
            "api"
            "v2"
            "facts"
            "today"
          ]
          select: {
            exist: [
              "accept"
              "language"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
